list(PREPEND CMAKE_MODULE_PATH "${PS4_PORT_SOURCE}/client/cmake")
set(BUILD_CLIENT ON CACHE BOOL "" FORCE)
foreach(flag BUILD_SERVER BUILD_UNITTESTS BUILD_BENCHMARKS BUILD_DOCUMENTATION BUILD_WITH_TRACY ENABLE_LTO RUN_IN_PLACE ENABLE_SOUND ENABLE_GETTEXT ENABLE_CURSES ENABLE_POSTGRESQL ENABLE_LEVELDB ENABLE_REDIS ENABLE_PROMETHEUS ENABLE_SPATIAL ENABLE_OPENSSL ENABLE_LUAJIT ENABLE_SYSTEM_GMP ENABLE_SYSTEM_JSONCPP LUA_USE_DLOPEN ENABLE_UPDATE_CHECKER USE_SDL3 ENABLE_OPENGL ENABLE_GLES2)
 set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(flag ENABLE_CURL USE_SDL2_STATIC ENABLE_OPENGL3)
 set(${flag} ON CACHE BOOL "" FORCE)
endforeach()
set(CMAKE_CXX_EXTENSIONS ON)
set(CUSTOM_SHAREDIR "/app0/luanti/share" CACHE STRING "" FORCE)
set(CUSTOM_BINDIR "bin" CACHE STRING "" FORCE)
set(CUSTOM_DOCDIR "doc" CACHE STRING "" FORCE)
set(CUSTOM_LOCALEDIR "/app0/luanti/share/locale" CACHE STRING "" FORCE)
set(VERSION_EXTRA "ps4-alpha1" CACHE STRING "" FORCE)
set(ZLIB_INCLUDE_DIR "${PORT_ROOT}/sources/mesa/subprojects/zlib-1.3.1" CACHE PATH "" FORCE)
set(ZLIB_LIBRARY "${PORT_ROOT}/mesa-build/subprojects/zlib-1.3.1/libz.a" CACHE FILEPATH "" FORCE)
set(PNG_PNG_INCLUDE_DIR "${PORT_ROOT}/voxel-deps/include" CACHE PATH "" FORCE)
set(PNG_LIBRARY_RELEASE "${PORT_ROOT}/voxel-deps/lib/liblibpng16_static.a" CACHE FILEPATH "" FORCE)
set(JPEG_INCLUDE_DIR "${PORT_ROOT}/voxel-deps/include" CACHE PATH "" FORCE)
set(JPEG_LIBRARY_RELEASE "${PORT_ROOT}/voxel-deps/lib/libjpeg.a" CACHE FILEPATH "" FORCE)
set(FREETYPE_INCLUDE_DIR_ft2build "${PORT_ROOT}/client-deps/include/freetype2" CACHE PATH "" FORCE)
set(FREETYPE_INCLUDE_DIR_freetype2 "${PORT_ROOT}/client-deps/include/freetype2" CACHE PATH "" FORCE)
set(FREETYPE_LIBRARY_RELEASE "${PORT_ROOT}/client-deps/lib/libfreetype.a" CACHE FILEPATH "" FORCE)
set(SQLITE3_INCLUDE_DIR "${PORT_ROOT}/client-deps/include" CACHE PATH "" FORCE)
set(SQLITE3_LIBRARY "${PORT_ROOT}/client-deps/lib/libsqlite3.a" CACHE FILEPATH "" FORCE)
set(ZSTD_INCLUDE_DIR "${PORT_ROOT}/client-deps/include" CACHE PATH "" FORCE)
set(ZSTD_LIBRARY "${PORT_ROOT}/client-deps/lib/libzstd.a" CACHE FILEPATH "" FORCE)
# No libc Linux headers or optional host libraries may enter the destination build.
add_compile_definitions(SDL_ORBIS_ENABLE_AUDIO=0 SDL_ORBIS_ENABLE_JOYSTICK=1 SDL_ORBIS_ENABLE_VIDEO=1)
include_directories("${PS4_PORT_SOURCE}/client/src")
