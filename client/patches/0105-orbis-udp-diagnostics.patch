+// Bounded diagnostics for the first UDP operations on a PS4 client launch.
+// Do not print packet contents, addresses, or user-entered text.
+static std::atomic<unsigned> g_ps4_udp_socket_logs{0};
+static std::atomic<unsigned> g_ps4_udp_bind_logs{0};
+static std::atomic<unsigned> g_ps4_udp_send_logs{0};
+static std::atomic<unsigned> g_ps4_udp_poll_logs{0};
+static std::atomic<unsigned> g_ps4_udp_poll_error_logs{0};
+static std::atomic<unsigned> g_ps4_udp_receive_logs{0};
+
+static bool ps4_udp_diagnostic_slot(std::atomic<unsigned> &counter)
+{
+	unsigned count = counter.load(std::memory_order_relaxed);
+	while (count < 8) {
+		if (counter.compare_exchange_weak(count, count + 1,
+				std::memory_order_relaxed))
+			return true;
+	}
+	return false;
+}
