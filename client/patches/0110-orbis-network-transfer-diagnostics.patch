+// PS4-only, low-volume transfer diagnostics. Never record packet contents,
+// addresses, names, or account data.
+#pragma once
+
+#if defined(__ORBIS__)
+#include <atomic>
+#include <cstdint>
+
+namespace ps4_network_diagnostics {
+struct Counters {
+	std::atomic<uint64_t> socket_rx{0};
+	std::atomic<uint64_t> socket_tx{0};
+	std::atomic<uint64_t> socket_poll_errors{0};
+	std::atomic<uint64_t> socket_recv_errors{0};
+	std::atomic<uint64_t> socket_send_errors{0};
+	std::atomic<uint64_t> mtp_rx{0};
+	std::atomic<uint64_t> mtp_control{0};
+	std::atomic<uint64_t> mtp_data{0};
+	std::atomic<uint64_t> media_packets{0};
+	std::atomic<uint64_t> ack_received{0};
+	std::atomic<uint64_t> ack_matched{0};
+	std::atomic<uint64_t> ack_unmatched{0};
+	std::atomic<uint64_t> ack_queued{0};
+	std::atomic<uint64_t> ack_send_attempts{0};
+	std::atomic<uint64_t> reliable_resends{0};
+	std::atomic<uint64_t> split_chunks{0};
+	std::atomic<uint64_t> split_complete{0};
+	std::atomic<uint64_t> split_invalid{0};
+	std::atomic<uint64_t> last_mtp_rx_ms{0};
+	std::atomic<uint64_t> last_report_ms{0};
+};
+
+inline Counters counters;
+
+struct Snapshot {
+	uint64_t socket_rx, socket_tx, socket_poll_errors, socket_recv_errors;
+	uint64_t socket_send_errors, mtp_rx, mtp_control, mtp_data, media_packets;
+	uint64_t ack_received, ack_matched, ack_unmatched, ack_queued, ack_send_attempts;
+	uint64_t reliable_resends, split_chunks, split_complete, split_invalid;
+	uint64_t last_mtp_rx_ms;
+};
+
+inline Snapshot take_snapshot()
+{
+	return {
+		counters.socket_rx.exchange(0, std::memory_order_relaxed),
+		counters.socket_tx.exchange(0, std::memory_order_relaxed),
+		counters.socket_poll_errors.exchange(0, std::memory_order_relaxed),
+		counters.socket_recv_errors.exchange(0, std::memory_order_relaxed),
+		counters.socket_send_errors.exchange(0, std::memory_order_relaxed),
+		counters.mtp_rx.exchange(0, std::memory_order_relaxed),
+		counters.mtp_control.exchange(0, std::memory_order_relaxed),
+		counters.mtp_data.exchange(0, std::memory_order_relaxed),
+		counters.media_packets.exchange(0, std::memory_order_relaxed),
+		counters.ack_received.exchange(0, std::memory_order_relaxed),
+		counters.ack_matched.exchange(0, std::memory_order_relaxed),
+		counters.ack_unmatched.exchange(0, std::memory_order_relaxed),
+		counters.ack_queued.exchange(0, std::memory_order_relaxed),
+		counters.ack_send_attempts.exchange(0, std::memory_order_relaxed),
+		counters.reliable_resends.exchange(0, std::memory_order_relaxed),
+		counters.split_chunks.exchange(0, std::memory_order_relaxed),
+		counters.split_complete.exchange(0, std::memory_order_relaxed),
+		counters.split_invalid.exchange(0, std::memory_order_relaxed),
+		counters.last_mtp_rx_ms.load(std::memory_order_relaxed)
+	};
+}
+} // namespace ps4_network_diagnostics
+#endif
