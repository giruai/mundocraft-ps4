+static void ps4_report_network_diagnostics(bool force)
+{
+	const int saved_errno = errno;
+	auto &diag = ps4_network_diagnostics::counters;
+	const u64 now = porting::getTimeMs();
+	u64 last = diag.last_report_ms.load(std::memory_order_relaxed);
+	if (last == 0) {
+		if (!force) {
+			diag.last_report_ms.compare_exchange_strong(last, now,
+					std::memory_order_relaxed);
+			errno = saved_errno;
+			return;
+		}
+		if (diag.last_report_ms.compare_exchange_strong(last, now,
+				std::memory_order_relaxed))
+			last = now;
+		else
+			last = diag.last_report_ms.load(std::memory_order_relaxed);
+	}
+	if (force || now - last >= 5000) {
+		if (diag.last_report_ms.compare_exchange_strong(last, now,
+				std::memory_order_relaxed)) {
+			const auto s = ps4_network_diagnostics::take_snapshot();
+			const u64 rx_age = s.last_mtp_rx_ms && now >= s.last_mtp_rx_ms ?
+				now - s.last_mtp_rx_ms : 0;
+			infostream << "PS4_NET window_ms=" << (now - last)
+					<< " socket_rx=" << s.socket_rx << " socket_tx=" << s.socket_tx
+					<< " poll_err=" << s.socket_poll_errors
+					<< " recv_err=" << s.socket_recv_errors
+					<< " send_err=" << s.socket_send_errors
+					<< " mtp_rx=" << s.mtp_rx << " control=" << s.mtp_control
+					<< " data=" << s.mtp_data << " media=" << s.media_packets
+					<< " ack_rx=" << s.ack_received << " ack_match=" << s.ack_matched
+					<< " ack_unmatched=" << s.ack_unmatched
+					<< " ack_queued=" << s.ack_queued
+					<< " ack_send_attempt=" << s.ack_send_attempts
+					<< " reliable_resend=" << s.reliable_resends
+					<< " split_chunks=" << s.split_chunks
+					<< " split_complete=" << s.split_complete
+					<< " split_invalid=" << s.split_invalid
+					<< " rx_age_ms=" << rx_age << std::endl;
+		}
+	}
+	errno = saved_errno;
 }
 #endif
 
