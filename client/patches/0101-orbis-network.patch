@@ -33,25 +33,57 @@
 #define SOCKET_ERR_STR(e) strerror(e)
 #endif
 
+#if defined(__ORBIS__)
+#include <orbis/Net.h>
+#endif
+
 static bool g_sockets_initialized = false;
+#if defined(__ORBIS__)
+static int32_t g_net_pool = -1;
+extern "C" void ps4_luanti_resolver_cleanup();
+extern "C" int32_t ps4_luanti_net_pool()
+{
+	return g_net_pool;
+}
+#endif
 
 // Initialize sockets
 void sockets_init()
 {
+	if (g_sockets_initialized)
+		return;
 #ifdef _WIN32
 	// Windows needs sockets to be initialized before use
 	WSADATA WsaData;
 	if (WSAStartup(MAKEWORD(2, 2), &WsaData) != NO_ERROR)
 		throw SocketException("WSAStartup failed");
+#elif defined(__ORBIS__)
+	// The POSIX socket entry points still need the PS4 network service.
+	int32_t result = sceNetInit();
+	if (result != 0)
+		throw SocketException("sceNetInit failed: " + std::to_string(result));
+	g_net_pool = sceNetPoolCreate("luanti", 512 * 1024, 0);
+	if (g_net_pool < 0) {
+		int32_t pool_error = g_net_pool;
+		sceNetTerm();
+		throw SocketException("sceNetPoolCreate failed: " + std::to_string(pool_error));
+	}
 #endif
 	g_sockets_initialized = true;
 }
 
 void sockets_cleanup()
 {
+	if (!g_sockets_initialized)
+		return;
 #ifdef _WIN32
 	// On Windows, cleanup sockets after use
 	WSACleanup();
+#elif defined(__ORBIS__)
+	ps4_luanti_resolver_cleanup();
+	sceNetPoolDestroy(g_net_pool);
+	g_net_pool = -1;
+	sceNetTerm();
 #endif
 	g_sockets_initialized = false;
 }
