+local function finite_number(value)
+	return type(value) == "number" and value == value
+		and value ~= math.huge and value ~= -math.huge
+end
+
+-- Preserve valid records and their extension fields; normalize fields used by
+-- sorting/rendering. JSON objects, scalar results and non-record entries must
+-- not reach the ordering code as though they were a list of server records.
+local function validate_servers(result)
+	local clean, indices = {}, {}
+	if type(result) ~= "table" then return clean end
+	for i in pairs(result) do
+		if finite_number(i) and i >= 1 and i == math.floor(i) then
+			indices[#indices + 1] = i
+		end
+	end
+	table.sort(indices)
+	for _, i in ipairs(indices) do
+		local item = result[i]
+		if type(item) == "table" and type(item.address) == "string"
+				and item.address ~= "" then
+			local port = (type(item.port) == "number" or type(item.port) == "string")
+				and tonumber(item.port) or nil
+			if finite_number(port) and port >= 1 and port <= 65535
+					and port == math.floor(port) then
+				local record = {}
+				for k, v in pairs(item) do record[k] = v end
+				record.port = port
+				for _, key in ipairs({"clients", "clients_max", "ping", "lag", "uptime"}) do
+					if not finite_number(record[key]) or record[key] < 0 then
+						record[key] = nil
+					end
+				end
+				for _, key in ipairs({"proto_min", "proto_max"}) do
+					if not finite_number(record[key]) then record[key] = nil end
+				end
+				for _, key in ipairs({"name", "description", "version", "gameid", "url"}) do
+					if type(record[key]) ~= "string" then record[key] = nil end
+				end
+				if not valid_continent(record.geo_continent) then
+					record.geo_continent = nil
+				end
+				clean[#clean + 1] = record
+			end
+		end
+	end
+	return clean
+end
